{
  "name": "nisomnia",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite --port 3000",
    "generate-routes": "tsr generate",
    "generate-api-types": "for attempt in 1 2 3; do bun x --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 openapi-typescript https://api.nisomnia.com/public/spec.json -o ./src/lib/api/types.d.ts && exit 0; done; exit 1",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "test": "vitest run",
    "prepare": "lefthook install",
    "predev": "bun run generate-api-types",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "bun run lint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "isomorphic-dompurify": "^4.1.0",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "nitro": "npm:nitro-nightly@3.0.1-20260901-102404-5d83475c",
    "node-html-parser": "^9.0.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tailwindcss": "^1.10.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "vitest": "4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  }
}
